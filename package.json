{
  "name": "kisisel-sistemim",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "check": "npm run lint && npm run typecheck && npm run build",
    "test:supabase": "node scripts/verify-supabase-runtime.mjs",
    "test:projects": "node scripts/verify-project-domain.mjs",
    "test:studio-projects": "node scripts/verify-studio-project-crud.mjs",
    "test:studio-navigation": "node --experimental-strip-types --test scripts/verify-studio-navigation.test.mjs",
    "test:tasks": "node --test scripts/verify-studio-tasks.test.mjs",
    "test:database": "node scripts/verify-studio-database.mjs",
    "test": "npm run test:studio-navigation && npm run test:tasks && npm run test:database && npm run test:projects && npm run test:studio-projects && npm run test:supabase && node scripts/verify-studio-auth.mjs && npm run test:public && npm run test:public-pages && npm run test:library && npm run test:journey && npm run test:profile",
    "test:public": "node --experimental-strip-types --loader ./scripts/ts-alias-loader.mjs --test src/features/public/content/public-project-repository.test.mjs src/features/public/content/public-content.policy.test.mjs src/features/public/content/public-content.release.test.mjs",
    "test:http": "node scripts/verify-studio-http.mjs",
    "test:public-http": "node scripts/verify-public-http.mjs",
    "test:public-pages": "node --test scripts/verify-public-pages.test.mjs",
    "test:library": "node --test scripts/verify-studio-library.test.mjs",
    "test:journey": "node --test scripts/verify-studio-journey.test.mjs",
    "test:profile": "node --test scripts/verify-studio-profile.test.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.0",
    "@supabase/supabase-js": "2.110.2",
    "next": "16.4.3",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.11",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "description": "Ziyaattin için public portföy ve özel Studio çalışma alanı.",
  "engines": {
    "node": "22.x"
  }
}
